/* =========================================================
   BTS Website Stylesheet (style.css)
   Theme: Midnight Purple & Glassmorphic Accents
========================================================= */

:root {
  --bg-primary: #0a0713;
  --bg-secondary: #130d24;
  --bg-card: rgba(26, 18, 48, 0.65);
  --purple-accent: #9333ea;
  --purple-light: #c084fc;
  --purple-glow: rgba(147, 51, 234, 0.35);
  --text-primary: #f3f4f6;
  --text-muted: #a1a1aa;
  --border-color: rgba(168, 85, 247, 0.18);
  --font-heading: 'Cinzel', serif;
  --font-body: 'Plus Jakarta Sans', sans-serif;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  overflow-x: hidden;
}

/* Typography Helpers */
h1, h2, h3, h4 {
  font-family: var(--font-heading);
  letter-spacing: 0.5px;
}

/* Navbar */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(10, 7, 19, 0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
}

.nav-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 1rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-logo {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--text-primary);
  text-decoration: none;
  letter-spacing: 2px;
}

.nav-logo span {
  font-size: 0.9rem;
  color: var(--purple-light);
  font-weight: 400;
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 1.5rem;
}

.nav-links a {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 0.9rem;
  font-weight: 500;
  transition: color 0.25s ease;
}

.nav-links a:hover {
  color: var(--purple-light);
}

/* Hero Section */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 6rem 1.5rem 5rem;
  background: radial-gradient(circle at 50% 30%, rgba(147, 51, 234, 0.22) 0%, transparent 70%);
}

.hero-badge {
  display: inline-block;
  background: rgba(147, 51, 234, 0.2);
  color: var(--purple-light);
  border: 1px solid var(--purple-accent);
  border-radius: 999px;
  padding: 0.4rem 1.1rem;
  font-size: 0.85rem;
  font-weight: 600;
  margin-bottom: 1.5rem;
}

.hero-title {
  font-size: 3.2rem;
  font-weight: 800;
  margin-bottom: 1rem;
  background: linear-gradient(135deg, #ffffff 40%, var(--purple-light) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  max-width: 650px;
  font-size: 1.1rem;
  color: var(--text-muted);
  margin-bottom: 2rem;
}

.btn-primary {
  display: inline-block;
  background: linear-gradient(135deg, #7c3aed, #9333ea);
  color: #fff;
  padding: 0.85rem 1.8rem;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 600;
  box-shadow: 0 0 20px var(--purple-glow);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 30px rgba(147, 51, 234, 0.6);
}

/* Sections Common */
.content-section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 4.5rem 1.5rem;
}

.dark-alt {
  background-color: var(--bg-secondary);
  border-radius: 24px;
  margin-top: 2rem;
  margin-bottom: 2rem;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-tag {
  color: var(--purple-light);
  text-transform: uppercase;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 2px;
}

.section-header h2 {
  font-size: 2.2rem;
  color: var(--text-primary);
  margin-top: 0.4rem;
}

/* Cards Grid */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
}

.info-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 2rem;
  border-radius: 16px;
  backdrop-filter: blur(10px);
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.info-card:hover {
  transform: translateY(-4px);
  border-color: var(--purple-light);
}

.card-icon {
  font-size: 2rem;
  margin-bottom: 1rem;
}

.info-card h3 {
  font-size: 1.25rem;
  margin-bottom: 0.8rem;
  color: #fff;
}

.info-card p {
  color: var(--text-muted);
  font-size: 0.95rem;
}

/* Timeline */
.timeline {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.timeline-item {
  display: flex;
  gap: 2rem;
  padding: 1.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 14px;
}

.timeline-date {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.2rem;
  color: var(--purple-light);
  min-width: 120px;
}

.timeline-content h3 {
  font-size: 1.15rem;
  margin-bottom: 0.4rem;
}

.timeline-content p {
  color: var(--text-muted);
  font-size: 0.95rem;
}

/* Achievements Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1rem;
  margin-bottom: 2.5rem;
}

.stat-card {
  background: rgba(147, 51, 234, 0.1);
  border: 1px solid var(--purple-accent);
  border-radius: 14px;
  text-align: center;
  padding: 1.5rem;
}

.stat-card h4 {
  font-size: 2.5rem;
  color: var(--purple-light);
}

.stat-card p {
  font-size: 0.85rem;
  color: var(--text-muted);
  font-weight: 600;
  margin-top: 0.3rem;
}

/* Members Grid */
.members-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
}

.member-pill {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 1.25rem;
  border-radius: 12px;
  text-align: center;
}

.member-pill h4 {
  font-size: 1.1rem;
  color: var(--text-primary);
  margin-bottom: 0.3rem;
}

.member-pill p {
  font-size: 0.85rem;
  color: var(--purple-light);
}

/* Footer */
.footer {
  text-align: center;
  padding: 3rem 1.5rem;
  border-top: 1px solid var(--border-color);
  color: var(--text-muted);
  font-size: 0.9rem;
}

.footer .copyright {
  margin-top: 0.4rem;
  font-size: 0.8rem;
  opacity: 0.7;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .hero-title {
    font-size: 2.3rem;
  }
  .nav-links {
    display: none; /* simple fallback for compact mobile */
  }
  .timeline-item {
    flex-direction: column;
    gap: 0.5rem;
  }
}
